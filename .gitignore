# Local datasets, preparation and reusable training/evaluation caches.
/data/
/prepared_inputs/
/artifacts/
/results/
/reports/
*.npz
*.csv
*.png
*.pdf

# Publish only the trained comparison policies and reviewed evidence.
!/agents/comparison/*.npz
!/evidence/*.csv
!/evidence/nominal.png

# Environments, credentials and Python caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.env.*
*kaggle.json

# Temporary files and downloaded archives.
*.aux
*.out
*.synctex.gz
*.sqlite*
*.log
*.zip
*.tar*
*.bz2
*.gz
.DS_Store
Thumbs.db

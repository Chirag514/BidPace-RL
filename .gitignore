# Data and full training/verification caches stay local.
/data/
/results/*
/my_run/
/reproduction/
*.npz
*.csv
*.png
*.pdf

# Publish only these standalone agents and reviewed evidence files.
!/agents/primary_agent.npz
!/agents/empirical_agent.npz
!/results/final_summary.csv
!/results/final_evaluation.csv
!/results/candidate_comparisons.json
!/Report.pdf
!/paired_gains.png

# Environments, credentials and Python caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.env.*
*kaggle.json

# Temporary files and downloaded archives.
*.aux
*.out
*.synctex.gz
*.sqlite*
*.log
*.zip
*.tar*
*.bz2
*.gz
.DS_Store
Thumbs.db
